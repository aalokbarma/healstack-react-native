# HealStack example — copy to `.env` and fill in local values.
# Never commit real production keys.

# Required: hs_test_* or hs_live_* (placeholder below is invalid until you replace it)
EXPO_PUBLIC_HEALSTACK_API_KEY=hs_test_replace_me_XXXXXXXX

# Local HealStack-compatible ingest base URL (no trailing slash)
# iOS Simulator → host machine: http://127.0.0.1:8787
# Android Emulator → host machine: http://10.0.2.2:8787
# Physical device → your machine LAN IP, e.g. http://192.168.1.10:8787
EXPO_PUBLIC_HEALSTACK_ENDPOINT=http://127.0.0.1:8787

# Required for plain http:// endpoints during local development
EXPO_PUBLIC_HEALSTACK_ALLOW_HTTP=true

EXPO_PUBLIC_HEALSTACK_ENVIRONMENT=development
EXPO_PUBLIC_HEALSTACK_RELEASE=dev.healstack.example@0.1.0
