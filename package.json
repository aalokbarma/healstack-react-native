{
  "name": "@healstack/react-native",
  "version": "0.1.0",
  "description": "HealStack application reliability SDK for React Native — capture, queue, and report runtime failures.",
  "license": "MIT",
  "author": "HealStack",
  "homepage": "https://github.com/healstack/healstack-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/healstack/healstack-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/healstack/healstack-sdk/issues"
  },
  "keywords": [
    "healstack",
    "react-native",
    "error-tracking",
    "crash-reporting",
    "observability",
    "reliability",
    "self-healing"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./lib/module/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./async-storage": {
      "import": {
        "types": "./lib/typescript/module/async-storage.d.ts",
        "default": "./lib/module/async-storage.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/async-storage.d.ts",
        "default": "./lib/commonjs/async-storage.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --watchman=false",
    "test:unit": "jest --watchman=false --selectProjects unit",
    "test:native": "jest --watchman=false --selectProjects native",
    "test:coverage": "jest --watchman=false --coverage",
    "build": "bob build",
    "validate:deps": "node scripts/assert-zero-deps.mjs",
    "validate:build": "node scripts/assert-build.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run validate:build && npm run validate:deps",
    "prepare": "node scripts/prepare.mjs"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react": ">=17",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "react-native-builder-bob": "^0.40.13",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
